{
  "uid": "modelmux-overview",
  "title": "ModelMux Overview",
  "description": "Gateway and worker metrics. No synthetic benchmark data, token counts, or cost estimates. Percentiles are histogram estimates; no traffic yields no latency data.",
  "tags": [
    "modelmux"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape targets",
      "description": "1 means Prometheus can reach the metrics listener. This is not dependency readiness.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "modelmux-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"modelmux\"}",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Collector health",
      "description": "0 means an application snapshot failed. Backlog values are unavailable, not zero.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "modelmux-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "modelmux_collector_up",
          "legendFormat": "{{service}} {{collector}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP requests / second",
      "description": "Normalized routes; unknown paths share one label. Includes authentication and validation failures.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "modelmux-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, status) (rate(modelmux_http_requests_total{service=\"gateway\"}[$__rate_interval]))",
          "legendFormat": "{{route}} {{status}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP latency p50 / p95",
      "description": "Histogram estimates over completed transports, including full stream lifetime. Not time to first token.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "modelmux-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, route) (rate(modelmux_http_duration_seconds_bucket{service=\"gateway\",outcome=\"completed\"}[$__rate_interval])))",
          "legendFormat": "p50 {{route}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(modelmux_http_duration_seconds_bucket{service=\"gateway\",outcome=\"completed\"}[$__rate_interval])))",
          "legendFormat": "p95 {{route}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Rejections / second",
      "description": "Per-client rate limiting and process-local capacity rejections are different controls.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "modelmux-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(modelmux_rate_limit_rejections_total{service=\"gateway\"}[$__rate_interval]))",
          "legendFormat": "rate limited",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (outcome) (rate(modelmux_admissions_total{service=\"gateway\",outcome=~\"queue_full|timeout|cancelled\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Gateway provider capacity",
      "description": "Process-local active permits and FIFO waiters; cache hits occupy neither.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "modelmux-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(modelmux_concurrency_active{service=\"gateway\"})",
          "legendFormat": "active",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(modelmux_concurrency_queued{service=\"gateway\"})",
          "legendFormat": "waiting",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Gateway queue wait p95",
      "description": "Includes admitted, timed-out, cancelled and full-queue acquisitions, separated by outcome.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "modelmux-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(modelmux_queue_wait_seconds_bucket{service=\"gateway\"}[$__rate_interval])))",
          "legendFormat": "{{outcome}}",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Provider latency p95",
      "description": "Actual calls only. Circuit skips are excluded; streaming includes consumer backpressure.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "modelmux-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service, provider, mode) (rate(modelmux_provider_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{service}} {{provider}} {{mode}}",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "title": "Provider errors and routing / second",
      "description": "Cancellations and consumer failures are separate from provider errors. Fallback counts routing decisions, even when the fallback circuit skips.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "modelmux-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, provider, outcome) (rate(modelmux_provider_calls_total{outcome=~\"transient_error|permanent_error\"}[$__rate_interval]))",
          "legendFormat": "{{service}} {{provider}} {{outcome}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (service, provider) (rate(modelmux_circuit_rejections_total[$__rate_interval]))",
          "legendFormat": "{{service}} {{provider}} circuit skipped",
          "range": true
        },
        {
          "refId": "C",
          "expr": "sum by (service) (rate(modelmux_fallbacks_total[$__rate_interval]))",
          "legendFormat": "{{service}} fallback",
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "title": "Circuit state (1 = current)",
      "description": "One-hot state per provider/process; scrape snapshots do not initiate probes. Do not sum replicas to infer a single circuit.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "modelmux-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "modelmux_circuit_state",
          "legendFormat": "{{service}} {{instance}} {{provider}} {{state}}",
          "range": true
        }
      ]
    },
    {
      "id": 11,
      "title": "Cache decisions / second",
      "description": "Only ordinary chat handlers. MISS does not guarantee a write; BYPASS includes opt-out or read failure.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "modelmux-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(modelmux_cache_lookups_total{service=\"gateway\"}[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "range": true
        }
      ]
    },
    {
      "id": 12,
      "title": "SSE outcomes / second",
      "description": "Handler outcomes, independent of HTTP status: a partial answer can fail after HTTP 200.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "modelmux-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(modelmux_streams_total{service=\"gateway\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "range": true
        }
      ]
    },
    {
      "id": 13,
      "title": "Durable async backlog",
      "description": "Authoritative Postgres nonterminal jobs, not RabbitMQ message count. Retry depth includes scheduled backoff. max avoids double-counting gateway replicas.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "modelmux-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (status) (modelmux_jobs_depth{service=\"gateway\"})",
          "legendFormat": "{{status}}",
          "range": true
        }
      ]
    },
    {
      "id": 14,
      "title": "Worker attempt outcomes / second",
      "description": "Claimed local attempts, not unique jobs. Success includes the result-write call; a fenced stale write can be a no-op.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "modelmux-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(modelmux_job_attempts_total{service=\"worker\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(modelmux_job_retries_started_total{service=\"worker\"}[$__rate_interval]))",
          "legendFormat": "retries started",
          "range": true
        }
      ]
    },
    {
      "id": 15,
      "title": "Worker attempt latency p95",
      "description": "Includes inference routing and persistence; does not include time before the claim.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "modelmux-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(modelmux_job_attempt_duration_seconds_bucket{service=\"worker\"}[$__rate_interval])))",
          "legendFormat": "{{outcome}}",
          "range": true
        }
      ]
    },
    {
      "id": 16,
      "title": "Worker queue wait p95",
      "description": "Wait is measured from attempt availability until claim; intentional retry backoff is excluded.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "modelmux-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(modelmux_job_queue_wait_seconds_bucket{service=\"worker\"}[$__rate_interval])))",
          "legendFormat": "queue wait p95",
          "range": true
        }
      ]
    }
  ]
}
