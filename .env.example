PORT=3000
# Internal metrics listeners; Compose overrides the host to its private network.
METRICS_HOST=127.0.0.1
GATEWAY_METRICS_PORT=9464
WORKER_METRICS_PORT=9465
# Local Grafana login is admin / this password. Change before non-local use.
GRAFANA_ADMIN_PASSWORD=modelmux-local-only
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REQUEST_TIMEOUT_MS=120000
# Hosted fallback is disabled unless a model map and API key are configured.
# Mapping an Ollama model opts its conversations into hosted inference on failure.
OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL_MAP=
# Example: OPENAI_FALLBACK_MODEL_MAP='{"llama3.2":"your-openai-chat-model"}'
OPENAI_REQUEST_TIMEOUT_MS=30000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
# Increase when combined provider timeouts exceed the default 150 seconds.
PROVIDER_STOP_GRACE_PERIOD=180s
DATABASE_URL=postgresql://modelmux:modelmux@localhost:5432/modelmux
REDIS_URL=redis://localhost:6379
# Only POST /v1/chat with X-Cache-Mode: use reads/writes the exact cache.
# Set TTL to 0 to disable globally. Bump VERSION after in-place model updates.
CHAT_CACHE_TTL_SECONDS=300
CHAT_CACHE_MAX_ENTRY_BYTES=65536
CHAT_CACHE_TIMEOUT_MS=100
CHAT_CACHE_VERSION=1
RABBITMQ_URL=amqp://modelmux:modelmux@localhost:5672
PROVIDER_MAX_CONCURRENCY=2
PROVIDER_MAX_QUEUE_SIZE=20
PROVIDER_QUEUE_TIMEOUT_MS=30000
JOB_CONCURRENCY=2
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_MS=1000
# Only needed when gateway runs in Docker; points to your existing host Postgres.
DOCKER_DATABASE_URL=postgresql://modelmux:modelmux@host.docker.internal:5432/modelmux
